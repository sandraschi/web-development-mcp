# Web Development MCP — environment template (no secrets; copy to .env)
# MCP transport: stdio (Claude Desktop default) | http | sse (deprecated)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=10853
MCP_PATH=/mcp
# Proxy tools from other MCP servers (comma-separated HTTP URLs, optional)
MCP_BRIDGE_URLS=
# Webapp ports (must match fleet-start.config.ps1 + operations/WEBAPP_PORTS.md)
WEB_PORT=10853
VITE_PORT=10852
WEB_FRONTEND_PORT=10852
# Cloud LLM keys (optional; server-side only — never put these in the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# External wrappee executable override (optional)
WEB_DEVELOPMENT_EXECUTABLE=
