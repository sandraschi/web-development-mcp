import { useState, useEffect } from 'react';
import { Sidebar } from '@/components/dashboard/Sidebar';
import { Topbar } from '@/components/dashboard/Topbar';
import { HelpModal } from '@/components/dashboard/HelpModal';
import { LogViewModal } from '@/components/dashboard/LogViewModal';
import { Chatbot } from '@/components/dashboard/Chatbot';
import { cn } from '@/lib/utils';

interface DashboardLayoutProps {
  children: React.ReactNode;
}

export function DashboardLayout({ children }: DashboardLayoutProps) {
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [theme, setTheme] = useState<'light' | 'dark'>('light');
  const [helpOpen, setHelpOpen] = useState(false);
  const [logsOpen, setLogsOpen] = useState(false);
  const [currentPath, setCurrentPath] = useState('/');

  // Initialize theme from localStorage or system preference
  useEffect(() => {
    const savedTheme = localStorage.getItem('theme') as 'light' | 'dark' | null;
    if (savedTheme) {
      setTheme(savedTheme);
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      setTheme('dark');
    }
  }, []);

  // Apply theme to document
  useEffect(() => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    localStorage.setItem('theme', theme);
  }, [theme]);

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      // Cmd/Ctrl + B: Toggle sidebar
      if ((e.metaKey || e.ctrlKey) && e.key === 'b') {
        e.preventDefault();
        setSidebarCollapsed((prev) => !prev);
      }
      // Cmd/Ctrl + /: Open help
      if ((e.metaKey || e.ctrlKey) && e.key === '/') {
        e.preventDefault();
        setHelpOpen(true);
      }
      // Cmd/Ctrl + .: Toggle theme
      if ((e.metaKey || e.ctrlKey) && e.key === '.') {
        e.preventDefault();
        setTheme((prev) => (prev === 'light' ? 'dark' : 'light'));
      }
      // Cmd/Ctrl + L: Open logs
      if ((e.metaKey || e.ctrlKey) && e.key === 'l') {
        e.preventDefault();
        setLogsOpen(true);
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  const handleNavigate = (path: string) => {
    setCurrentPath(path);
    // In a real app, use your router here:
    // router.push(path);
    
    // Handle special paths
    if (path === '/logs') {
      setLogsOpen(true);
    }
  };

  const toggleTheme = () => {
    setTheme((prev) => (prev === 'light' ? 'dark' : 'light'));
  };

  return (
    <div className="flex h-screen overflow-hidden bg-background">
      {/* Sidebar */}
      <Sidebar
        collapsed={sidebarCollapsed}
        onToggle={() => setSidebarCollapsed(!sidebarCollapsed)}
        onNavigate={handleNavigate}
        onHelpClick={() => setHelpOpen(true)}
        currentPath={currentPath}
      />

      {/* Main Content */}
      <div className="flex flex-1 flex-col overflow-hidden">
        {/* Topbar */}
        <Topbar
          theme={theme}
          onThemeToggle={toggleTheme}
          onNotificationsClick={() => handleNavigate('/notifications')}
          onSettingsClick={() => handleNavigate('/settings')}
          notificationCount={5}
          userName="Sandra"
          userEmail="sandra@example.com"
        />

        {/* Page Content */}
        <main
          className={cn(
            'flex-1 overflow-auto p-6 transition-all duration-300',
            sidebarCollapsed ? 'ml-0' : 'ml-0'
          )}
        >
          {children}
        </main>
      </div>

      {/* Modals */}
      <HelpModal
        open={helpOpen}
        onOpenChange={setHelpOpen}
        onContactSupport={() => {
          // Handle contact support
          console.log('Contact support clicked');
        }}
      />

      <LogViewModal
        open={logsOpen}
        onOpenChange={setLogsOpen}
        onClearLogs={() => {
          // Handle clear logs
          console.log('Clear logs clicked');
        }}
        onRefresh={() => {
          // Handle refresh logs
          console.log('Refresh logs clicked');
        }}
      />

      {/* Floating Chatbot */}
      <Chatbot
        ollamaUrl="http://localhost:11434"
        defaultModel="llama3.2:3b"
        systemPrompt="You are a helpful assistant for a dashboard application. Help users navigate and understand the dashboard features. Be concise and friendly."
        title="AI Assistant"
      />
    </div>
  );
}

